@@ -642,6 +642,46 @@ static void aspeed_2700_sdmc_write(AspeedSDMCState *s, uint32_t reg,
     s->regs[reg] = data;
 }
 
+/*
+ * Fault-injection properties (local patch P3): DRAM ECC error injection.
+ * Setting "inject-ecc-error"=true records an ECC failure in the SDMC status
+ * registers (R_ECC_FAIL_STATUS / R_ECC_FAIL_ADDR), which firmware can read
+ * at 0x12c00078 / 0x12c0007c. "ecc-error-addr" selects the reported address.
+ * (Physical SError delivery is not implemented in TCG ARM, so the fault is
+ * exposed through the SDMC status registers, matching the SoC's error path.)
+ */
+static bool aspeed_sdmc_get_inject_ecc_error(Object *obj, Error **errp)
+{
+    return ASPEED_SDMC(obj)->regs[R_ECC_FAIL_STATUS] != 0;
+}
+
+static void aspeed_sdmc_set_inject_ecc_error(Object *obj, bool value,
+                                             Error **errp)
+{
+    AspeedSDMCState *s = ASPEED_SDMC(obj);
+
+    if (value) {
+        s->regs[R_ECC_FAIL_STATUS] |= 0x1;  /* ECC error flag (bit per datasheet) */
+        s->regs[R_ECC_FAIL_ADDR] = s->ecc_err_addr;
+    } else {
+        s->regs[R_ECC_FAIL_STATUS] &= ~0x1;
+    }
+}
+
+static void aspeed_2700_sdmc_initfn(Object *obj)
+{
+    AspeedSDMCState *s = ASPEED_SDMC(obj);
+
+    object_property_add_bool(obj, "inject-ecc-error",
+                             aspeed_sdmc_get_inject_ecc_error,
+                             aspeed_sdmc_set_inject_ecc_error);
+    object_property_add_uint32_ptr(obj, "ecc-error-addr", &s->ecc_err_addr,
+                                   OBJ_PROP_FLAG_READWRITE);
+    object_property_add_uint32_ptr(obj, "ecc-fail-status",
+                                   &s->regs[R_ECC_FAIL_STATUS],
+                                   OBJ_PROP_FLAG_READ);
+}
+
 static const uint64_t
     aspeed_2700_ram_sizes[] = { 256 * MiB, 512 * MiB, 1024 * MiB,
                                 2048 * MiB, 4096 * MiB, 8192 * MiB, 0};
